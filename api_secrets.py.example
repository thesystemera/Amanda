# api_secrets.py
# Copy this file to api_secrets.py and configure your keys,
# or create keys/gemini_key.txt with your Gemini API key.
#
# NOTE: api_secrets.py is gitignored — do NOT commit real keys.

import os


def _load_key(path: str) -> str:
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    except FileNotFoundError:
        return ""


# Priority: environment variable → keys/gemini_key.txt → keys/api_secrets.txt
GEMINI_API_KEY = (
    os.environ.get("GEMINI_API_KEY", "")
    or _load_key("keys/gemini_key.txt")
    or _load_key("keys/api_secrets.txt")
)
